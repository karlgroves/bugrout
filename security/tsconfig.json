{
  // The security regression tests are not inside any one workspace, so they
  // cannot live under a workspace tsconfig. This exists so typescript-eslint's
  // project service can resolve them for `security/`'s own `lint` script —
  // security/ is a workspace (#306) only so that `turbo run lint` reaches it,
  // and so that @types/node resolves.
  //
  // `module` is inherited from tsconfig.base.json (ESNext). The NodeNext it
  // replaced classified these files as CommonJS, since security/package.json
  // has no "type", and rejected every `import.meta`.
  //
  // Type-checked by `pnpm run typecheck:root` (`tsc -b`), not through Turbo.
  // The JS scanner wrappers and root scripts/ are tsconfig.scripts.json. These
  // files are executed by `node --import tsx`.
  //
  // This used to `references` a second project, tsconfig.workers.json, which
  // type-checked the Cloudflare Workers source the tests imported with
  // @cloudflare/workers-types and nothing else — those globals must not enter
  // a Node-typed program. The endpoint suites and the Workers source moved to
  // AFixt/bugrout-server on 2026-11-15, so no test here imports Workers code
  // and that project is gone. If one ever does again, bring it back rather
  // than widening `types`.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./.tsbuild/tests.tsbuildinfo"
  },
  "include": ["tests/**/*.ts"]
}
