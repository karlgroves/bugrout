{
  "name": "@bugrout/route-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@bugrout/worker-utils": "workspace:*",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
