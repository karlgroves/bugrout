{
  "name": "bugrout",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "doctor": "pnpm --filter @bugrout/mobile run doctor",
    "bundle:check": "pnpm --filter @bugrout/mobile run bundle:check",
    "usecases:build": "pnpm --filter @bugrout/mobile exec expo export --platform web --output-dir ../../.usecase-dist",
    "usecases:serve": "serve -s .usecase-dist -l 4599 --no-clipboard",
    "usecases:validate": "usecase-runner validate docs/use-cases",
    "usecases:run": "usecase-runner run docs/use-cases --config usecase-runner.config.yaml",
    "usecases:generate": "usecase-runner generate docs/use-cases --outdir e2e/generated",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "dupes": "jscpd .",
    "links": "lychee --no-progress --config lychee.toml \"./**/*.md\"",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:fs": "trivy fs --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --scanners vuln,secret --skip-dirs node_modules --quiet .",
    "security:fs:report": "trivy fs --severity HIGH,CRITICAL --exit-code 0 --scanners vuln,secret --skip-dirs node_modules --format json --output reports/security/trivy-fs.json .",
    "security:docker": "hadolint backend/services/valhalla/Dockerfile backend/services/route-tracker/Dockerfile",
    "security:iac": "checkov -d . --quiet --compact --skip-path node_modules --skip-path .git && trivy config --severity HIGH,CRITICAL --exit-code 1 --quiet .",
    "security:iac:report": "checkov -d . --skip-path node_modules --skip-path .git --output json --output-file-path reports/security && mv reports/security/results_json.json reports/security/checkov.json && trivy config --exit-code 0 --format json --output reports/security/trivy-config.json .",
    "security:container": "trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --quiet \"$BUGROUT_IMAGE\"",
    "security:osv": "osv-scanner scan --lockfile pnpm-lock.yaml",
    "security:semgrep": "node security/scripts/semgrep.mjs",
    "security:secrets": "gitleaks detect --no-banner --redact",
    "security:tests": "node --import tsx --test security/tests/*.test.ts",
    "security:headers": "node security/scripts/check-headers.js",
    "security:report": "node security/scripts/generate-security-report.mjs",
    "security": "run-p security:audit security:osv security:secrets security:tests security:fs security:docker security:iac",
    "license:check": "node scripts/check-licenses.mjs",
    "license:report": "pnpm licenses list --prod --long > reports/licenses.txt || pnpm licenses list --prod",
    "check": "run-s format:check lint typecheck test markdownlint",
    "check:all": "run-s check doctor dupes links security security:semgrep license:check",
    "ci": "pnpm run check:all",
    "ai:context": "node scripts/ai-context.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.0.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jscpd": "5.0.14",
    "lint-staged": "17.3.0",
    "markdownlint-cli2": "0.23.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "tsx": "^4.23.9",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "@babel/core@<7.29.6": ">=7.29.6 <8",
      "@tootallnate/once@2.0.0": ">=2.0.1",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6",
      "esbuild@<0.28.1": ">=0.28.1 <1",
      "fast-uri@<4.1.2": ">=4.1.2 <5",
      "form-data@>=4 <4.0.6": ">=4.0.6 <5",
      "js-yaml@>=3 <3.15.1": ">=3.15.1 <4",
      "js-yaml@>=4 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss@>=8 <8.5.23": ">=8.5.23 <9",
      "shell-quote@<1.9.0": ">=1.9.0 <2",
      "tar@>=7 <7.5.21": ">=7.5.21 <8",
      "undici@<6.28.0": ">=6.28.0 <7",
      "undici@>=7 <7.29.0": ">=7.29.0 <8",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "ws@>=6 <6.2.4": ">=6.2.4 <7",
      "ws@>=7 <7.5.11": ">=7.5.11 <8",
      "ws@>=8 <8.20.1": ">=8.20.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
