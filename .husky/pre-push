# Fail on the first failing command. husky's shim already runs hooks as
# `sh -e` (.husky/_/h), so this changes nothing today — it is here so the
# hook does not depend on that. Without it, under a plain `sh` a failing
# step is ignored and the last command's exit code decides the result.
set -e

# Full local gate: format, lint, typecheck, tests, markdown (Turbo-cached),
# then the fast repo-wide scanners. Semgrep/OSV/links run in CI and via
# `pnpm run check:all`.
pnpm run check
pnpm run dupes
# ~0.4s. A broken workflow does not fail a build, it changes what the build is,
# so the cheapest place to catch one is before it is pushed.
pnpm run lint:actions
pnpm run security:secrets
pnpm run license:check
