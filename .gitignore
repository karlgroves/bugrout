.wrangler/
.dev.vars

# Data pipeline outputs
data-pipeline/output/
*.osm.pbf
*.pmtiles
*.mbtiles
planetiler.jar
data-pipeline/data/sources/

# Secrets / local credentials (never commit)
cloudflare_token

# Expo bundle-check output (CI gate artifact)
.expo-export/

# Scanner and licence reports (build outputs, uploaded as CI artifacts)
reports/

# Use-case runner: the web build it drives, and the Playwright specs it
# compiles to. Build outputs; the .uc.yaml files are the source.
.usecase-dist/
e2e/generated/
screenshots/

# Claude Code session worktrees (machine-local; sibling sessions check out here)
.claude/
