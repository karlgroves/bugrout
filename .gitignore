*.orig.*

# Native builds
ios/
android/
*.ipa
*.apk
*.aab
# ...but not the Valhalla native module's own ios/ and android/ binding
# sources, which are hand-written and must be committed (#145). Its fetched
# dependencies and built libraries are outputs of build-scripts/.
!apps/mobile/native-modules/valhalla/ios/
!apps/mobile/native-modules/valhalla/android/
apps/mobile/native-modules/valhalla/deps/
apps/mobile/native-modules/valhalla/bin/

# The cross-compile's object tree, alongside deps/ and bin/ above.
apps/mobile/native-modules/valhalla/build/

# Data-pipeline output: downloaded OSM extracts, built PMTiles and Valhalla
# routing tiles, and the generated valhalla.json. Produced by the scripts in
# data-pipeline/, several GB. It was untracked but not ignored, so
# `prettier --check` scanned the generated JSON and failed the gate.
data-pipeline/osm/output/

# Environment. Expo also reads .env.production, .env.development and
# .env.preview, so every variant is ignored, not just the *.local ones (#307).
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

