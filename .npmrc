save-exact=true
engine-strict=true

# The pnpm equivalent lives in pnpm-workspace.yaml (`minimumReleaseAge`) and is
# the one that actually governs installs here. This exists so a stray `npm`
# invocation behaves the same way rather than quietly resolving a package
# published an hour ago.
#
# Needs npm >= 11.10; older npm ignores the key. Set anyway: it costs nothing
# and becomes effective the moment the toolchain catches up.
min-release-age=7
